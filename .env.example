# Server
PORT=3000

# DDU result scraping target. Semester is fixed to 3 by default.
RESULT_PORTAL_URL="https://ddugorakhpur.com/result2023/searchresult_new.aspx"
# Optional comma-separated fallbacks used if primary portal does not load.
RESULT_PORTAL_URLS="https://result.ddugu.ac.in/result2023/searchresult_new.aspx"
RESULT_PORTAL_SEMESTER=3
SCRAPE_MAX_RETRIES=3
SCRAPE_DELAY_MS=3000
SCRAPE_RETRY_DELAY_MS=15000
SCRAPER_NAVIGATION_TIMEOUT_MS=60000
SCRAPER_SELECTOR_TIMEOUT_MS=20000
SCRAPER_HEADLESS=true

# Local fallback database file
DB_FILE="college_results.db"

# Cloud DB target (schema file: server/supabase-schema.sql)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_API_KEY=""
SUPABASE_ANON_KEY=""
